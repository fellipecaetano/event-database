function queryString(querystring) {
  var parts = [];
  var names = Object.keys(querystring);
  for (var i = 0; i < names.length; i++) {
    var name = names[i];
    var parameter = querystring[name];
    if (parameter.multiValue) {
      for (var j = 0; j < parameter.multiValue.length; j++) {
        parts.push(
          encodeURIComponent(name) +
            "=" +
            encodeURIComponent(parameter.multiValue[j].value),
        );
      }
    } else {
      parts.push(
        encodeURIComponent(name) + "=" + encodeURIComponent(parameter.value),
      );
    }
  }
  return parts.length ? "?" + parts.join("&") : "";
}

function redirect(location) {
  return {
    statusCode: 301,
    statusDescription: "Moved Permanently",
    headers: { location: { value: location } },
  };
}

function handler(event) {
  var request = event.request;
  var uri = request.uri;

  if (request.headers.host.value === "www.musicaemsp.com.br") {
    return redirect(
      "https://musicaemsp.com.br" + uri + queryString(request.querystring),
    );
  }

  if (
    uri === "/inbox" ||
    uri === "/past" ||
    /^\/past\/[0-9]{4}$/.test(uri) ||
    /^\/events\/[^/]+$/.test(uri)
  ) {
    return redirect(uri + "/" + queryString(request.querystring));
  }

  if (uri.charAt(uri.length - 1) === "/") {
    request.uri = uri + "index.html";
  }

  return request;
}
