{
  "name": "@event-database/inbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:lambda && pnpm build:site",
    "build:lambda": "esbuild functions/create-upload-intents.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda/create-upload-intents.cjs && zip -jqFS dist/lambda/create-upload-intents.zip dist/lambda/create-upload-intents.cjs",
    "build:site": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "oidc-client-ts": "3.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "28.1.0",
    "vite": "8.1.5"
  }
}
